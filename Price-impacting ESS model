* ============================================= *
*  ESD optimisation and power market operation  *
* ============================================= *

* Objective function: maximise profit (sum of half-hourly revenue)
profit_eq ..
    profit =e= sum(t, P(t) * (d(t) - c(t)));

* Revenue in each period
revenue_eq(t) ..
    Revenue(t) =e= P(t) * (d(t) - c(t));
 
* Residual load calculation, with load adjusted to reflect annual growth rate
residual_load_eq(t) ..
    ResLoad(t) =e= L(t,'load') - RenewGen(t,'gen') - d(t) + c(t);
   
* Residual load BigM for negative power prices 
regime_detection(t) ..
    L(t,'load') - RenewGen(t,'gen') =l= bigM * positive_regime(t) - 0.001 * (1-positive_regime(t));

* Demand constraint: total generation must equal residual load
demand_eq(t) ..
    sum(g, q(g,t)) =e= max(0, L(t,'load') - RenewGen(t,'gen') - d(t) + c(t));

* Capacity constraint: each generator cannot exceed its capacity
capacity_eq(g,t) ..
    q(g,t) =l= generator_data(g,'cap');

* Marginal generator BigM for merit order effect
marginal_constraint1(g,t) ..
    ResLoad(t) - generator_data(g,'cum_cap') =l= (1 - is_marginal(g,t) + (1-positive_regime(t))) * bigM;
marginal_constraint2(g,t) ..
    generator_data(g-1,'cum_cap') - ResLoad(t) =l= (1 - is_marginal(g,t) + (1-positive_regime(t))) * bigM;

* Positive residual load regime corresponds to the merit order curve
single_marginal(t) ..
    sum(g, is_marginal(g,t)) =e= positive_regime(t);

* Price determination: set price as the MC of the marginal generator in equilibrium in positive regime and as -10 in negative regime
price_eq(t) ..
    P(t) =e= FCAdj * positive_regime(t) * sum(g, generator_data(g,'mc') * is_marginal(g,t)) 
           + (1-positive_regime(t)) * (-10);
    
* ESD energy balance constraint
ESD_balance(t) ..
    z(t) =e= z(t-1) + eta * (c(t) - d(t));
* Set initial ESD charge level to zero
    z.fx('t1') = z0;

* Charge and discharge constraints: power capacity
charge_limit(t) ..
    c(t) =l= R_max;
discharge_limit(t) ..
    d(t) =l= R_max;
* Ensure ESD cannot charge and discharge simultaneously
charging_discharging(t) ..
    c(t) =l= is_charging(t) * R_max;
discharging_charging(t) ..
    d(t) =l= (1-is_charging(t)) * R_max;

* Energy storage capacity
* Discharge at full power depletes storage in one hour (i.e. two periods)
storage_limit_d(t) ..
    d(t) =l= z(t);
storage_limit_z(t) ..
    z(t) =l= S_max * DoD;

* Non-negativity constraints
non_negativity_d(t) .. d(t) =g= 0;
non_negativity_c(t) .. c(t) =g= 0;
non_negativity_z(t) .. z(t) =g= 0;

* Declare the model
Model German_power_market /all/;

* Allow 10% tolerance to improve solution time
Option optcr = 0.2;

* Solve
Solve German_power_market using MINLP maximizing profit;

* Price variance analysis
MeanP = sum(t, P.l(t)) / card(t);
VarP = sum(t, sqr(P.l(t) - MeanP)) / card(t);
display VarP;

* Display ESD results
Display profit.l, P.l, Revenue.l, ResLoad.l, d.l, c.l, z.l;

* ============================================= *
*        ESD cost reduction calculations        *
* ============================================= *

base_power_cost = power_cost;
base_energy_cost = energy_cost;
base_om_cost = ESD_om_cost;

* Determine relevant cost years before and after base cost year of 2021
Set relevant_cost_years(cost_years);

* Initialise variables
Scalar 
    next_cost_year "Next cost year after base year" / 0 /
    prev_cost_year "Previous cost year before base year" / 0 /
    next_factor "Cost reduction factor for next cost year" / 0 /
    prev_factor "Cost reduction factor for previous cost year" / 0 /;
   
* Find closest years to base cost year (i.e. 2020 and 2025)

    prev_cost_year = 0;
    next_cost_year = 0;
    prev_factor = 0;
    next_factor = 0;
    
Loop(cost_years,
    if(ord(cost_years) * 5 + 2010 <= base_cost_year, 
        prev_cost_year = ord(cost_years) * 5 + 2010;
        prev_factor = cost_reduction(cost_years,'%STORAGE_TYPE%');
    );
    if(ord(cost_years) * 5 + 2010 > base_cost_year and next_cost_year = 0, 
        next_cost_year = ord(cost_years) * 5 + 2010;
        next_factor = cost_reduction(cost_years,'%STORAGE_TYPE%');
    );
);
    
* Interpolate five-yearly forecast data for cost reduction factor for base cost year
base_year_factor = prev_factor + (next_factor - prev_factor) * 
                  (base_cost_year - prev_cost_year) / (next_cost_year - prev_cost_year);

* Calculate factors for each year relative to base cost year (2021), rather than relative to 2015
* Current year is 'start_year + ord(y) - 1'
Loop(y,
    prev_cost_year = 0;
    next_cost_year = 0;
    prev_factor = 0;
    next_factor = 0;
    
    Loop(cost_years,
        if(ord(cost_years) * 5 + 2010 <= start_year + ord(y) - 1, 
            prev_cost_year = ord(cost_years) * 5 + 2010;
            prev_factor = cost_reduction(cost_years,'%STORAGE_TYPE%');
        );
        if(ord(cost_years) * 5 + 2010 > start_year + ord(y) - 1 and next_cost_year = 0, 
            next_cost_year = ord(cost_years) * 5 + 2010;
            next_factor = cost_reduction(cost_years,'%STORAGE_TYPE%');
        );
    );
    
* If beyond last cost year point, use the last value
    if(next_cost_year = 0,
        next_cost_year = prev_cost_year;
        next_factor = prev_factor;
    );

* Current years' factor
if(prev_cost_year = next_cost_year,
        yearly_cost_factor(y) = prev_factor / base_year_factor;
    else
        yearly_cost_factor(y) = (prev_factor + (next_factor - prev_factor) * 
                              (start_year + ord(y) - 1 - prev_cost_year) / 
                              (next_cost_year - prev_cost_year)) / base_year_factor;
    );
);

* ============================================= *
*    Economic feasibility (post-optimisation)   *
* ============================================= *

* Initial investment
initial_investment = energy_cost * S_max + power_cost * R_max;

* Total energy discharged per day and cycles
total_discharged = sum(t, d.l(t))/4;
daily_cycles = total_discharged / S_max;
* Scale to sample period
annual_cycles = daily_cycles * days_per_year;
total_cycles = annual_cycles * ESD_lifetime;

* Annual profit
annual_profit = profit.l * (days_per_year);
* Scale to sample period (divide by # of days covered in data)

* Annual O&M costs
annual_om_cost = ESD_om_cost * R_max;

* Calculate annual cashflows for each year
Parameter Annual_cashflow_calc(y);

Loop(y,
    initial_investment_by_year(y) = (base_energy_cost * yearly_cost_factor(y) * S_max + 
                                   base_power_cost * yearly_cost_factor(y) * R_max);
);

* First year investment is actual initial investment
initial_investment = initial_investment_by_year('y1');

* O&M costs with yearly reduction
Parameter annual_om_cost_by_year(y) "Annual O&M costs with reduction factor";
Loop(y,
    annual_om_cost_by_year(y) = base_om_cost * yearly_cost_factor(y) * R_max;
);

* Annual cashflows with reduced O&M costs
Loop(y,
    Annual_cashflow_calc(y) = annual_profit - annual_om_cost_by_year(y);
);

* ESD degradation
Annual_cashflow_calc(y) = Annual_cashflow_calc(y) * (1 - degradation_rate * (ord(y)-1));

* Discounted cashflows (DCF)
Parameter Discounted_cashflow_calc(y);
Discounted_cashflow_calc(y) = Annual_cashflow_calc(y) / power((1 + discount_rate), ord(y));

* Calculate NPV
NPV = -initial_investment;
Loop(y$(ord(y) <= ESD_lifetime),
    npv = npv + Annual_cashflow_calc(y) / power((1 + discount_rate), ord(y));
);

* Discounted charging cost
charging_cost = sum(t, (P.l(t) * c.l(t)));
annual_charging_cost = charging_cost * (days_per_year/4);
discounted_charging_cost = sum(y$(ord(y) <= ESD_lifetime), annual_charging_cost / power((1 + discount_rate), ord(y)));

* Discounted profit and cost
discounted_profit = sum(y$(ord(y) <= ESD_lifetime), annual_profit / power((1 + discount_rate), ord(y)));
discounted_cost = initial_investment + discounted_charging_cost + sum(y$(ord(y) <= ESD_lifetime), annual_om_cost / power((1 + discount_rate), ord(y)));

* LCOS (Levelised Cost of electricity Storage)
LCOS = discounted_cost / (total_discharged * days_per_year * ESD_lifetime);

* Simple payback period
payback_period = initial_investment / (annual_profit - annual_om_cost);

* Internal rate of return (IRR) via interpolation
Parameter
    NPV_at_rate(i) "NPV at different discount rates"
    rate(i) "Test discount rates";
    
Table rate_values(i,*) "Values for discount rates"
         value
i1       -0.30         
i2       -0.25
i3       -0.20
i4       -0.15
i5       -0.10
i6       -0.05
i7       0.00
i8       0.05
i9       0.10
i10      0.15
i11      0.20
i12      0.25
i13      0.30
i14      0.35
i15      0.40
i16      0.45
i17      0.50
i18      0.55

Display IRR, NPV_at_rate, discounted_profit, charging_cost, discounted_charging_cost, discounted_cost, total_discharged, initial_investment, annual_profit, annual_om_cost, Annual_cashflow_calc, 
       Discounted_cashflow_calc, NPV, payback_period, LCOS, daily_cycles, annual_cycles, total_cycles, base_year_factor, yearly_cost_factor;


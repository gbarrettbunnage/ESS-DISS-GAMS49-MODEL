rate(i) = rate_values(i, 'value');

* NPV at different discount rates
Loop(i,
    NPV_at_rate(i) = -initial_investment;
    Loop(y$(ord(y) <= ESD_lifetime),
        NPV_at_rate(i) = NPV_at_rate(i) + Annual_cashflow_calc(y) / power((1 + rate(i)), ord(y));
    );
);

* Find where NPV changes sign (NPV crosses zero)
Parameter 
    rate_below, rate_above,
    NPV_below, NPV_above;

* Find rates where NPV changes from positive to negative
Loop(i$(ord(i) < card(i)),
    If((NPV_at_rate(i) > 0 and NPV_at_rate(i+1) < 0) or (NPV_at_rate(i) < 0 and NPV_at_rate(i+1) > 0),
        rate_below = rate(i);
        rate_above = rate(i+1);
        NPV_below = NPV_at_rate(i);
        NPV_above = NPV_at_rate(i+1);
    );
);

* Interpolate to approximate IRR
IRR = 100 * (rate_below + (rate_above - rate_below) * abs(NPV_below) / (abs(NPV_below) + abs(NPV_above)));
    
